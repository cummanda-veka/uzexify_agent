# uzexify site for the host's shared edge Caddy (/opt/edge on the server), which owns 80/443,
# keeps the Cloudflare trusted_proxies / CF-Connecting-IP settings in its global block and imports
# sites/*.caddy. scripts/deploy.sh substitutes PUBLIC_HOST and installs this file as
# /opt/edge/sites/uzexify.caddy. api and web are reached on the "edge" network by their aliases.

PUBLIC_HOST {
	encode zstd gzip

	# Behind the Cloudflare proxy the TLS-ALPN challenge never reaches Caddy; HTTP-01 on port 80 does.
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	# The page shown to visitors outside the allowed countries, and what it needs to render.
	@open path /blocked /_next/* /favicon.ico /icon.png /apple-icon.png
	handle @open {
		reverse_proxy uzexify-web:3000
	}

	handle {
		# Country gate (backend /internal/geo): 204 passes, otherwise its redirect or 403 is returned.
		# X-Forwarded-For is overwritten with the resolved client IP, so a client cannot inject one.
		forward_auth uzexify-api:8000 {
			uri /internal/geo
			header_up X-Forwarded-For {client_ip}
		}
		handle /api/* {
			reverse_proxy uzexify-api:8000 {
				header_up X-Forwarded-For {client_ip}
				flush_interval -1
			}
		}
		handle {
			reverse_proxy uzexify-web:3000
		}
	}
}
